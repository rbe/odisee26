# Determine script directory
SCRIPT_DIR=$(pushd $(dirname $0) >/dev/null ; pwd ; popd >/dev/null)
# Read configuration
. ${SCRIPT_DIR}/../etc/odienv
# Odisee library
. ${SCRIPT_DIR}/odilib

if [[ -z "${JAVA_HOME}" ]]
then
    echo "Odisee: Please set JAVA_HOME"
    exit 1
fi

#set -o nounset
#set -o errexit

# ---------------------------------------------------------------------------
#
# Command Line.
#
# ---------------------------------------------------------------------------

#
# Execute a command.
#
exec_cmdopt() {
    # Create instance(s)
    if [ x"$(is_cmdopt c i)" = x"true" ]
    then
        # Only create non-existing instances
        for i in $(_splitcmdopt i)
        do
            add_instance $i
        done
    fi
    # Manage instance(s)
    if [ x"$(is_cmdopt m i)" = x"true" ]
    then
        for i in $(_splitcmdopt i)
        do
            manage_instance $i
        done
    fi
    # Watch instance(s)
    if [ x"$(is_cmdopt w i)" = x"true" ]
    then
        for i in $(_splitcmdopt i)
        do
            nohup $0 watch_instance $i 1>${ODISEE_LOG}/watchdog_$i.log 2>&1 &
        done
    fi
    # Remove instance(s)
    if [ x"$(is_cmdopt r i)" = x"true" ]
    then
        for i in $(_splitcmdopt i)
        do
            remove_instance $i
        done
    fi
    # List instances
    if [ x"$(is_cmdopt L)" = x"true" ]
    then
        list_instances
    fi
    if [ x"$(is_cmdopt l)" = x"true" ]
    then
        for i in $(_splitcmdopt l)
        do
            show_instance $i
        done
    fi
    # Show Odisee status: show status of all instances
    if [ x"$(is_cmdopt s)" = x"true" ]
    then
        for i in $(list_instances)
        do
            show_instance $i
        done
    fi
    # Maintenance operations
    if [ x"$(is_cmdopt q)" = x"true" ]
    then
        # If no instance(s) were given with -i, look for autostart instance(s)
        if [ x"$(is_cmdopt i)" = x"false" ]
        then
            cmdopt[i]=$(grep "true$" ${ODISEE_INST} | awk -F\| '{print $1}')
            if [ ${#cmdopt[i]} -eq 0 ]
            then
                echo "Odisee: No instances configured for autostart."
            fi
        fi
        for q in $(_splitcmdopt q)
        do
            case $q in
                findooo)
                    find_installation
                    [ -n "${FOUND_HOME}" ] && echo "Found installation in ${FOUND_HOME}" || echo "No installation found"
                ;;
                start) # Start OOo instance(s) and application server
                    for i in $(_splitcmdopt i)
                    do
                        start_instance $i
                    done
                    start_appsrv
                ;;
                stop) # Stop OOo instance(s) and application server
                    stop_appsrv
                    for i in $(_splitcmdopt i)
                    do
                        stop_instance $i
                    done
                ;;
                start-inst) # Start OOo instance(s)
                    for i in $(_splitcmdopt i)
                    do
                        start_instance $i
                    done
                ;;
                stop-inst) # Stop OOo instance(s)
                    for i in $(_splitcmdopt i)
                    do
                        stop_instance $i
                    done
                ;;
                restart) # Restart OOo instance(s) and application server
                    stop_appsrv
                    for i in $(_splitcmdopt i)
                    do
                        stop_instance $i
                        start_instance $i
                    done
                    start_appsrv
                ;;
                updateoxt) # Update OOo extensions
                    update_odisee_oxt
                ;;
                *)
                    echo "Odisee: Unknown or missing command."
                ;;
            esac
        done
    fi
}

#
# Execute commands local.
#
_exec_local() {
    show_copyr
    # Excecute commands local
    if [ ${#cmdopt[*]} -gt 0 ]
    then
        check_cmdopt
        if [ $BADENV = false -a $CMDOK = true ]
        then
            exec_cmdopt
            cleanup
        fi
    elif [ $BADENV = false ]
    then
        show_help
    fi
}

# ---------------------------------------------------------------------------
#
# Help.
#
# ---------------------------------------------------------------------------

#
# Show help
#
show_help() {
    cat <<EOF
Modes
  -c                                    Create something.
  -d                                    Disable something.
  -e                                    Enable something.
  -r                                    Remove something.
  -s                                    Show Odisee status.

  Depending on operation
  -t <type>                             Type of an operation.

Instance operations
  -L                                    List all instances.
  -l <instance>[,<instance>...]         Show details of certain instance(s).
  -g <group>                            Specify a group of instance(s). NOT IMPLEMENTED YET.
  -i <instance>[,<instance>...]         Instance(s) to operate on.
      -f <directory>                    OpenOffice installation directory for instance(s).
      -p <ip>:<port>                    Set IP address and port of instance(s).
      -m                                Manage (an) instance(s).
      -o option=value                   Specify an option, see below.
      -x <extension>[,<extension>...]   Manage extension(s).
         -t install                       Install an extension.
         -t remove                        Remove an extension.
      -y <directory>                    Data store for instance(s).

Options
  -o option=value                       Specify an option for one or more instance(s).
       autostart=<true|false>           Start/stop instance automatically? Default: true.
       headless=<true|false>            Don't show a window? Default: true.
       invisible=<true|false>
       nocrashreport=<true|false>       Disable crashreport? Default: true.
       nodefault=<true|false>           Don't open default document? Default: true.
       nofirststartwizard=<true|false>  Disable first start wizard? Default: true.
       nolockcheck=<true|false>         Don't do lock checks? Default: true.
       nologo=<true|false>              Don't show logo at startup? Default: true.

Maintenance
  OpenOffice instance(s)
  -q <operation>                        Execute maintenance command.
       findooo                          Try to guess and find an installation home.
       start                            Start one or more instance(s) given with -i. If no
                                        instances are given, starts all with option autostart=true.
       stop                             Same as above, but stops instance(s).
       restart                          Restart instance(s).
       updateoxt                        Update extensions under extensions/ and (re-)install them.

Accounts, callback hosts, and buckets
  user <name> <password>                Add one user. Writes etc/users and creates
                                        var/user/<name>/template, work, and output.
                                        A bad name fails. An existing user fails.
                                        There is no default password.
  callback-host <host>                  Append one host to etc/callback-hosts.
  bucket <user> <endpoint> <region> <bucket> <accessKey> <secret>
                                        Write that user's line in etc/buckets.
                                        The secret is the rest of the line.

Common options
  -h                                    Show help.
  -H                                    Show examples.
  -z                                    Force an operation.

EOF
}

# ---------------------------------------------------------------------------
#
# Accounts, callback hosts, and buckets.
# The person who can run odictl is the admin. There is no HTTP role check.
#
# ---------------------------------------------------------------------------

odictl_fail() {
    echo "Odisee: $*" >&2
    exit 1
}

odictl_trim() {
    local value="$1"
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    printf '%s' "$value"
}

odictl_lock() {
    mkdir -p "${ODISEE_HOME}/etc" || odictl_fail "could not create ${ODISEE_HOME}/etc"
    exec 9>>"${ODISEE_HOME}/etc/.odictl.lock" || odictl_fail "could not lock ${ODISEE_HOME}/etc"
    flock 9 || odictl_fail "could not lock ${ODISEE_HOME}/etc"
}

odictl_write_private() {
    local dest="$1"
    shift
    local dir tmp
    dir=$(dirname "$dest")
    mkdir -p "$dir" || odictl_fail "could not create ${dir}"
    tmp=$(mktemp "${dir}/.odictl.XXXXXX") || odictl_fail "could not write ${dest}"
    chmod 600 "$tmp" || true
    if [[ $# -gt 0 ]]
    then
        printf '%s\n' "$@" > "$tmp" || odictl_fail "could not write ${dest}"
    else
        : > "$tmp"
    fi
    mv -f "$tmp" "$dest" || odictl_fail "could not write ${dest}"
    chmod 600 "$dest" || true
}

odictl_require_user_name() {
    local name="$1"
    local backslash='\'
    if [[ -z "$name" || "$name" == *'/'* || "$name" == *"$backslash"* || "$name" == *'..'* || "$name" == *'*'* || "$name" == *'?'* || "$name" == *'['* ]]
    then
        odictl_fail "Invalid user '${name}'"
    fi
    local trimmed
    trimmed=$(odictl_trim "$name")
    if [[ -z "$trimmed" ]]
    then
        odictl_fail "Invalid user '${name}'"
    fi
    printf '%s' "$trimmed"
}

odictl_user_exists() {
    local file="$1"
    local name="$2"
    local line trimmed first
    [[ -f "$file" ]] || return 1
    while IFS= read -r line || [[ -n "$line" ]]
    do
        trimmed=$(odictl_trim "$line")
        [[ -z "$trimmed" || "$trimmed" == \#* ]] && continue
        first="${trimmed%%[[:space:]]*}"
        [[ "$first" == "$name" ]] && return 0
    done < "$file"
    return 1
}

odictl_bcrypt_jar() {
    if [[ -n "${ODICTL_BCRYPT_JAR:-}" && -f "${ODICTL_BCRYPT_JAR}" ]]
    then
        printf '%s' "${ODICTL_BCRYPT_JAR}"
        return 0
    fi
    if [[ -f "${SCRIPT_DIR}/odihash.jar" ]]
    then
        printf '%s' "${SCRIPT_DIR}/odihash.jar"
        return 0
    fi
    if [[ -n "${ODISEE_HOME:-}" && -f "${ODISEE_HOME}/bin/odihash.jar" ]]
    then
        printf '%s' "${ODISEE_HOME}/bin/odihash.jar"
        return 0
    fi
    local built="${SCRIPT_DIR}/../../../../build/odihash/odihash.jar"
    if [[ -f "$built" ]]
    then
        printf '%s' "$built"
        return 0
    fi
    return 1
}

odictl_hash_password() {
    local jar hash
    jar=$(odictl_bcrypt_jar) || odictl_fail "bcrypt helper not found"
    hash=$(java -jar "$jar" "$1") || odictl_fail "bcrypt helper failed"
    if [[ ! "$hash" =~ ^\$2[aby]\$ ]]
    then
        odictl_fail "bcrypt helper failed"
    fi
    printf '%s' "$hash"
}

odictl_user_write() {
    local file="$1"
    local name="$2"
    local hash="$3"
    local -a out=()
    local raw
    if [[ -f "$file" ]]
    then
        while IFS= read -r raw || [[ -n "$raw" ]]
        do
            out+=("$raw")
        done < "$file"
    else
        out+=('# Odisee users. One line: username bcrypt-hash [admin]')
        out+=('# The server reads this file. It does not read odisee-users.xml.')
    fi
    out+=("${name} ${hash}")
    odictl_write_private "$file" "${out[@]}"
}

odictl_cmd_user() {
    if [[ $# -ne 2 ]]
    then
        odictl_fail "usage: odictl user <name> <password>"
    fi
    local name password trimmed hash file
    name=$(odictl_require_user_name "$1") || exit 1
    password="$2"
    trimmed=$(odictl_trim "$password")
    if [[ -z "$trimmed" ]]
    then
        odictl_fail "Password is required"
    fi
    odictl_lock
    file="${ODISEE_HOME}/etc/users"
    if odictl_user_exists "$file" "$name"
    then
        odictl_fail "User '${name}' already exists"
    fi
    hash=$(odictl_hash_password "$password") || exit 1
    odictl_user_write "$file" "$name" "$hash"
    mkdir -p \
        "${ODISEE_HOME}/var/user/${name}/template" \
        "${ODISEE_HOME}/var/user/${name}/work" \
        "${ODISEE_HOME}/var/user/${name}/output" \
        || odictl_fail "could not create directories for '${name}'"
    echo "Odisee: User '${name}' created."
    exit 0
}

odictl_require_host() {
    local host trimmed
    host="$1"
    trimmed=$(odictl_trim "$host")
    if [[ ! "$trimmed" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$ ]]
    then
        odictl_fail "Invalid callback host '${host}'"
    fi
    printf '%s' "$trimmed"
}

odictl_host_listed() {
    local file="$1"
    local host="$2"
    local line trimmed lower want
    [[ -f "$file" ]] || return 1
    want=$(printf '%s' "$host" | tr '[:upper:]' '[:lower:]')
    while IFS= read -r line || [[ -n "$line" ]]
    do
        trimmed=$(odictl_trim "$line")
        [[ -z "$trimmed" || "$trimmed" == \#* ]] && continue
        lower=$(printf '%s' "$trimmed" | tr '[:upper:]' '[:lower:]')
        [[ "$lower" == "$want" ]] && return 0
    done < "$file"
    return 1
}

odictl_cmd_callback_host() {
    if [[ $# -ne 1 ]]
    then
        odictl_fail "usage: odictl callback-host <host>"
    fi
    local host file
    host=$(odictl_require_host "$1") || exit 1
    odictl_lock
    file="${ODISEE_HOME}/etc/callback-hosts"
    if odictl_host_listed "$file" "$host"
    then
        echo "Odisee: Callback host '${host}' listed."
        exit 0
    fi
    mkdir -p "${ODISEE_HOME}/etc" || odictl_fail "could not create ${ODISEE_HOME}/etc"
    if [[ -s "$file" ]]
    then
        printf '\n%s\n' "$host" >> "$file" || odictl_fail "could not write ${file}"
    else
        printf '%s\n' "$host" >> "$file" || odictl_fail "could not write ${file}"
    fi
    echo "Odisee: Callback host '${host}' listed."
    exit 0
}

odictl_require_token() {
    local value="$1"
    local label="$2"
    local pattern="$3"
    local token
    token=$(odictl_trim "$value")
    if [[ ! "$token" =~ $pattern ]]
    then
        odictl_fail "Invalid ${label} '${value}'"
    fi
    printf '%s' "$token"
}

odictl_require_endpoint() {
    local value rest hostpart lower
    value=$(odictl_trim "$1")
    lower="${value,,}"
    if [[ ! "$lower" =~ ^https?:// ]]
    then
        odictl_fail "Invalid endpoint '${1}'"
    fi
    rest="${value#*://}"
    if [[ -z "$rest" || "$rest" == /* || "$rest" == *@* || "$rest" == *\?* || "$rest" == *#* ]]
    then
        odictl_fail "Invalid endpoint '${1}'"
    fi
    hostpart="${rest%%/*}"
    if [[ -z "$hostpart" ]]
    then
        odictl_fail "Invalid endpoint '${1}'"
    fi
    printf '%s' "$value"
}

odictl_require_bucket_name() {
    local token
    token=$(odictl_require_token "$1" bucket '^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$') || exit 1
    if [[ "$token" == *..* ]]
    then
        odictl_fail "Invalid bucket '${1}'"
    fi
    printf '%s' "$token"
}

odictl_bucket_write() {
    local file="$1"
    local user="$2"
    local line="$3"
    local -a out=()
    local raw trimmed first replaced=0
    if [[ -f "$file" ]]
    then
        while IFS= read -r raw || [[ -n "$raw" ]]
        do
            trimmed=$(odictl_trim "$raw")
            if [[ -z "$trimmed" || "$trimmed" == \#* ]]
            then
                out+=("$raw")
                continue
            fi
            first="${trimmed%%[[:space:]]*}"
            if [[ "$first" == "$user" ]]
            then
                if [[ $replaced -eq 0 ]]
                then
                    out+=("$line")
                    replaced=1
                fi
                continue
            fi
            out+=("$raw")
        done < "$file"
    else
        out+=('# Odisee object storage. One line: username endpoint region bucket accessKey secret')
        out+=('# The server reads this file on each store. A restart is not required.')
    fi
    if [[ $replaced -eq 0 ]]
    then
        out+=("$line")
    fi
    odictl_write_private "$file" "${out[@]}"
}

odictl_cmd_bucket() {
    if [[ $# -lt 6 ]]
    then
        odictl_fail "Bucket configuration requires user, endpoint, region, bucket, accessKey, and secret"
    fi
    local user endpoint region bucket access secret line file
    user=$(odictl_require_user_name "$1") || exit 1
    endpoint=$(odictl_require_endpoint "$2") || exit 1
    region=$(odictl_require_token "$3" region '^[a-z0-9-]+$') || exit 1
    bucket=$(odictl_require_bucket_name "$4") || exit 1
    access=$(odictl_require_token "$5" accessKey '^[A-Za-z0-9._-]{1,128}$') || exit 1
    shift 5
    secret=$(odictl_trim "$*")
    if [[ -z "$secret" || "$secret" == *$'\n'* || "$secret" == *$'\r'* ]]
    then
        odictl_fail "A secret is required"
    fi
    line="${user} ${endpoint} ${region} ${bucket} ${access} ${secret}"
    odictl_lock
    file="${ODISEE_HOME}/etc/buckets"
    odictl_bucket_write "$file" "$user" "$line"
    echo "Odisee: Bucket '${bucket}' configured for '${user}'."
    exit 0
}

odictl_manage() {
    local cmd="$1"
    shift
    case "$cmd" in
        user)
            odictl_cmd_user "$@"
            ;;
        callback-host)
            odictl_cmd_callback_host "$@"
            ;;
        bucket)
            odictl_cmd_bucket "$@"
            ;;
        *)
            odictl_fail "Unknown command '${cmd}'"
            ;;
    esac
}

# ---------------------------------------------------------------------------
#
# Main.
#
# ---------------------------------------------------------------------------

#
# Cleanup.
#
cleanup() {
    exit 0
}

trap cleanup 1 2 3 5 9 15
ORIG_CMD="$(basename ${0%%.sh}) $*"

#
# DECLARATIONS
#

DEFAULT_OPTION[autostart]=true
DEFAULT_OPTION[headless]=true
DEFAULT_OPTION[invisible]=true
DEFAULT_OPTION[nocrashreport]=true
DEFAULT_OPTION[nodefault]=true
DEFAULT_OPTION[nofirststartwizard]=true
DEFAULT_OPTION[nolockcheck]=true
DEFAULT_OPTION[nologo]=true
# Command line option dependencies
CMD_DEPENDENCY_AND[c]="i"
CMD_DEPENDENCY_AND[d]="i"
CMD_DEPENDENCY_AND[e]="i"
CMD_DEPENDENCY_AND[m]="i"
CMD_DEPENDENCY_AND[o]="i m"
CMD_DEPENDENCY_AND[p]="i m"
CMD_DEPENDENCY_AND[r]="i"
# Command line option no-goes
CMD_DEPENDENCY_OR[i]="c f l m o p q r x"
# Command line option no-goes
#   -c, -d, -e and -r are mutually exclusive
CMD_NOGO[c]="d e r"
CMD_NOGO[d]="c e r"
CMD_NOGO[e]="c d r"
CMD_NOGO[r]="c d e"
#
CMDOK=true

# Accounts, callback hosts, and buckets. Flags such as -q stay below.
if [[ $# -ge 1 && "$1" != -* ]]
then
    case "$1" in
        user|callback-host|bucket)
            odictl_manage "$@"
            ;;
    esac
fi

# Parse parameters
while getopts ":cdehHmLrszf:i:l:o:p:q:t:u:x:y:" opt
do
    case $opt in
        c) cmdopt[c]=true ;;
        d) cmdopt[d]=true ;;
        e) cmdopt[e]=true ;;
        f) _acceptopt f $OPTARG ;;
        h) show_help; exit 0 ;;
        H) show_examples; exit 0 ;;
        i) _acceptopt i $OPTARG ;;
        l) _acceptopt l $OPTARG ;;
        L) cmdopt[L]=true ;;
        m) cmdopt[m]=true ;;
        o)
            n=$(echo $OPTARG | awk -F= '{print $1}')
            v=$(echo $OPTARG | awk -F= '{print $2}')
            option[$n]=$v
        ;;
        p) _acceptopt p $OPTARG ;;
        q) _acceptopt q $OPTARG ;;
        r) cmdopt[r]=true ;;
        s) cmdopt[s]=true ;;
        t) _acceptopt t $OPTARG ;;
        u) _acceptopt u $OPTARG ;;
        x) _acceptopt x $OPTARG ;;
        y) _acceptopt y $OPTARG ;;
        z) cmdopt[z]=true ;;
        \?)
            echo "Odisee: Unknown option -$OPTARG"
        ;;
        :)
            case $OPTARG in
                i)
                    echo "Odisee: Option -$OPTARG needs an instance name as argument."
                    echo "Odisee: e.g. $ORIG_CMD odi1"
                ;;
                *)
                    echo "Odisee: Option -$OPTARG needs an argument."
                ;;
            esac
            exit 1
        ;;
    esac
done

mkdir -p ${ODISEE_LOG}
[ ! -f ${ODISEE_INST} ] && touch ${ODISEE_INST}
_exec_local

exit 0
